{
	"schemaVersion": 1,
	"id": "gadzo",
	"version": "${version}",
	"name": "GADZO Client",
	"description": "A modern, high-performance custom Minecraft client: professional UI, draggable HUD editor, optimisation toggles, and a Create mod companion.",
	"authors": ["brambora1518"],
	"contact": {
		"sources": "https://github.com/brambora1518/GADZO-Client",
		"issues": "https://github.com/brambora1518/GADZO-Client/issues"
	},
	"license": "MIT",
	"environment": "client",
	"entrypoints": { "client": ["com.gadzo.client.GadzoClient"] },
	"mixins": [ { "config": "gadzo.mixins.json", "environment": "client" } ],
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	}
}
